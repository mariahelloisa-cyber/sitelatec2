# Copie para .env e preencha com os valores do seu projeto Supabase
# (Dashboard -> Project Settings -> API).
#
# Use SOMENTE a chave "anon / public". A "service_role" ignora o RLS e
# NUNCA pode entrar em variavel com prefixo VITE_ (tudo com VITE_ vai
# parar no bundle publico do navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
